# The editor's scene view (RENDERING.md section 7): game.graph plus the Gizmo pass, which draws
# the editor-layer instances (the selection) over the lit scene. The shadow atlas is imported from
# the shared frame phase (SharedPhase.hpp), which renders it once for every view. Forward renders HDR
# radiance into hdr, the Skybox fills what it left empty with the environment, and ToneMap maps it
# onto the LDR colour output the gizmos then draw over.
# Held to a hand-written C++ twin by RenderGraphTest (test_shipped_graphs.cpp).
version: 2
outputs:
  - slot: 0
    name: color
    format: R16G16B16A16Unorm
    size: RelativeToResult(1.0)
resources:
  - name: depth
    format: D32Float
    size: RelativeToResult(1.0)
  - name: hdr
    format: R16G16B16A16Float
    size: RelativeToResult(1.0)
imports:
  - name: shadowAtlas
    format: D32Float
passes:
  - type: DepthPrepass
    name: DepthPrepass
    bindings:
      depth: depth
  - type: Forward
    name: Forward
    bindings:
      color: hdr
      depth: depth
      shadowMap: shadowAtlas
    parameters:
      cullBackFaces: true
  - type: Skybox
    name: Skybox
    bindings:
      color: hdr
      depth: depth
  - type: ForwardTransparent
    name: ForwardTransparent
    bindings:
      color: hdr
      depth: depth
      shadowMap: shadowAtlas
  - type: ToneMap
    name: ToneMap
    bindings:
      hdr: hdr
      color: color
  - type: Gizmo
    name: Gizmo
    bindings:
      color: color
      depth: depth
