# The editor's scene view (RENDERING.md section 7): game.graph plus the Gizmo pass, which draws
# the editor-layer instances (the selection) over the lit scene. The shadow atlas is imported from
# the shared frame phase (SharedPhase.hpp), which renders it once for every view.
# Held to a hand-written C++ twin by RenderGraphTest (test_shipped_graphs.cpp).
version: 2
outputs:
  - slot: 0
    name: color
    format: R16G16B16A16Unorm
    size: RelativeToResult(1.0)
resources:
  - name: depth
    format: D32Float
    size: RelativeToResult(1.0)
imports:
  - name: shadowAtlas
    format: D32Float
passes:
  - type: DepthPrepass
    name: DepthPrepass
    bindings:
      depth: depth
  - type: Forward
    name: Forward
    bindings:
      color: color
      depth: depth
      shadowMap: shadowAtlas
    parameters:
      cullBackFaces: true
  - type: Gizmo
    name: Gizmo
    bindings:
      color: color
      depth: depth
