# The editor's scene view (RENDERING.md section 7): game.graph plus the selection's outline and the
# Gizmo pass's debug lines over the lit scene. The shadow atlas is imported from
# the shared frame phase (SharedPhase.hpp), which renders it once for every view. Forward renders HDR
# radiance into hdr, the Skybox fills what it left empty with the environment, ToneMap maps it
# onto ldr and Fxaa smooths that onto the LDR colour output. SelectionMask marks the selection's silhouette in selectionMask, and
# SelectionOutline outlines it over the colour before the gizmos draw.
# Held to a hand-written C++ twin by RenderGraphTest (test_shipped_graphs.cpp).
version: 2
outputs:
  - slot: 0
    name: color
    format: R16G16B16A16Unorm
    size: RelativeToResult(1.0)
resources:
  - name: depth
    format: D32Float
    size: RelativeToResult(1.0)
  - name: hdr
    format: R16G16B16A16Float
    size: RelativeToResult(1.0)
  - name: ao
    format: R8Unorm
    size: RelativeToResult(0.5)
  - name: ldr
    format: R16G16B16A16Unorm
    size: RelativeToResult(1.0)
  - name: bloom
    format: R16G16B16A16Float
    size: RelativeToResult(0.5)
  - name: selectionMask
    format: R8Unorm
    size: RelativeToResult(1.0)
imports:
  - name: shadowAtlas
    format: D32Float
passes:
  - type: DepthPrepass
    name: DepthPrepass
    bindings:
      depth: depth
  - type: Ssao
    name: Ssao
    bindings:
      depth: depth
      ao: ao
  - type: Forward
    name: Forward
    bindings:
      color: hdr
      depth: depth
      shadowMap: shadowAtlas
      ao: ao
    parameters:
      cullBackFaces: true
  - type: Skybox
    name: Skybox
    bindings:
      color: hdr
      depth: depth
  - type: ForwardTransparent
    name: ForwardTransparent
    bindings:
      color: hdr
      depth: depth
      shadowMap: shadowAtlas
  - type: Particles
    name: Particles
    bindings:
      color: hdr
      depth: depth
  - type: SelectionMask
    name: SelectionMask
    bindings:
      mask: selectionMask
  - type: Bloom
    name: Bloom
    bindings:
      hdr: hdr
      bloom: bloom
  - type: ToneMap
    name: ToneMap
    bindings:
      hdr: hdr
      bloom: bloom
      color: ldr
  - type: Fxaa
    name: Fxaa
    bindings:
      ldr: ldr
      color: color
  - type: SelectionOutline
    name: SelectionOutline
    bindings:
      color: color
      mask: selectionMask
  - type: Gizmo
    name: Gizmo
    bindings:
      color: color
      depth: depth
