# The editor's scene view (RENDERING.md section 7). Identical to game.graph for now; scene-only
# work such as gizmos arrives with layer-aware culling. The shadow atlas is imported from the
# shared frame phase (SharedPhase.hpp), which renders it once for every view.
# Held to a hand-written C++ twin by RenderGraphTest (test_shipped_graphs.cpp).
version: 2
outputs:
  - slot: 0
    name: color
    format: R16G16B16A16Unorm
    size: RelativeToResult(1.0)
resources:
  - name: depth
    format: D32Float
    size: RelativeToResult(1.0)
imports:
  - name: shadowAtlas
    format: D32Float
passes:
  - type: DepthPrepass
    name: DepthPrepass
    bindings:
      depth: depth
  - type: Forward
    name: Forward
    bindings:
      color: color
      depth: depth
      shadowMap: shadowAtlas
    parameters:
      cullBackFaces: true
