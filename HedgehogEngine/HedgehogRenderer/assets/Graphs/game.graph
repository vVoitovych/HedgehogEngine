# The game view (RENDERING.md section 7): what a camera entity renders, in the editor's game panel
# and in a game build. The shadow atlas is not the view's own: the shared frame phase renders it
# once for every view (SharedPhase.hpp), and the graph imports it. Forward renders HDR radiance into
# hdr, the Skybox fills what it left empty with the environment, ForwardTransparent blends the
# transparent materials over both, and ToneMap maps it onto the LDR
# colour output the game UI then draws over.
# Held to a hand-written C++ twin by RenderGraphTest (test_shipped_graphs.cpp).
version: 2
outputs:
  - slot: 0
    name: color
    format: R16G16B16A16Unorm
    size: RelativeToResult(1.0)
resources:
  - name: depth
    format: D32Float
    size: RelativeToResult(1.0)
  - name: hdr
    format: R16G16B16A16Float
    size: RelativeToResult(1.0)
imports:
  - name: shadowAtlas
    format: D32Float
passes:
  - type: DepthPrepass
    name: DepthPrepass
    bindings:
      depth: depth
  - type: Forward
    name: Forward
    bindings:
      color: hdr
      depth: depth
      shadowMap: shadowAtlas
    parameters:
      cullBackFaces: true
  - type: Skybox
    name: Skybox
    bindings:
      color: hdr
      depth: depth
  - type: ForwardTransparent
    name: ForwardTransparent
    bindings:
      color: hdr
      depth: depth
      shadowMap: shadowAtlas
  - type: ToneMap
    name: ToneMap
    bindings:
      hdr: hdr
      color: color
  - type: GameUi
    name: GameUi
    bindings:
      color: color
