#version 450

// Spawns one emitter instance's SpawnCount particles: each takes a dead particle, is placed on the
// emitter's shape with its start values and joins this frame's alive list, which Simulate then
// moves on. Past the dead list's end a spawn is dropped (and counted).

#include "Particles/Common.glsl"

layout(local_size_x = 64) in;

void main()
{
    EmitterData emitter = emitters[push.EmitterIndex];
    uint        i       = gl_GlobalInvocationID.x;
    if (i >= emitter.SpawnCount)
        return;

    int dead = atomicAdd(slots[emitter.SlotRow].Dead, -1);
    if (dead <= 0)
    {
        atomicAdd(slots[emitter.SlotRow].Dead, 1);
        atomicAdd(slots[emitter.SlotRow].Dropped, 1);
        return;
    }
    uint index = deadList[emitter.SlotFirst + uint(dead - 1)];

    uint     state    = Hash(emitter.Seed ^ Hash(i));
    Particle particle = SpawnParticle(emitter, state);
    particles[index]  = particle;

    int alive = atomicAdd(slots[emitter.SlotRow].Alive, 1);
    aliveIn[emitter.SlotFirst + uint(alive)] = index;
}
