#version 450

// Moves one emitter instance's alive particles on by the frame's time: gravity, drag and speed over
// life, then its collision: a HeightPlane bounces a particle off the plane z = PlaneHeight of the
// simulation space, a DepthBuffer off the scene as the shadow view saw it the frame before. A hit
// reflects the velocity times Bounce and costs LifetimeLoss of the lifetime. A particle past its
// lifetime goes back to the dead list; the rest join the next frame's alive list.

#include "Particles/Common.glsl"

layout(local_size_x = 64) in;

float CollisionDepthAt(vec2 uv)
{
    ivec2 texel = clamp(ivec2(uv * float(COLLISION_DEPTH_SIZE)), ivec2(0), ivec2(int(COLLISION_DEPTH_SIZE) - 1));
    return collisionDepth[uint(texel.y) * COLLISION_DEPTH_SIZE + uint(texel.x)];
}

vec3 CollisionWorldAt(EmitterData emitter, vec2 uv)
{
    vec4 point = emitter.DepthInverseViewProj * vec4(uv * 2.0 - 1.0, CollisionDepthAt(uv), 1.0);
    return point.xyz / point.w;
}

// Whether the move from before to after (world space) ends inside the depth's surface, no deeper
// than thickness; normal then faces where the particle came from.
bool HitDepth(EmitterData emitter, vec3 before, vec3 after, float thickness, out vec3 normal)
{
    vec4 clip = emitter.DepthViewProj * vec4(after, 1.0);
    if (clip.w <= 0.0)
        return false;
    vec3 ndc = clip.xyz / clip.w;
    if (any(greaterThan(abs(ndc.xy), vec2(1.0))))
        return false;
    vec2  uv    = ndc.xy * 0.5 + 0.5;
    float scene = CollisionDepthAt(uv);
    if (scene >= 1.0 || ndc.z <= scene)
        return false; // the sky, or in front of the surface
    vec3 surface = CollisionWorldAt(emitter, uv);
    if (distance(after, surface) > thickness)
        return false; // behind something, not in it
    float texel = 1.0 / float(COLLISION_DEPTH_SIZE);
    vec3  n     = cross(CollisionWorldAt(emitter, uv + vec2(texel, 0.0)) - surface,
                        CollisionWorldAt(emitter, uv + vec2(0.0, texel)) - surface);
    normal = length(n) > 1e-12 ? normalize(n) : normalize(before - surface + vec3(0.0, 0.0, 1e-6));
    if (dot(normal, before - surface) < 0.0)
        normal = -normal;
    return true;
}

void main()
{
    EmitterData emitter = emitters[push.EmitterIndex];
    uint        i       = gl_GlobalInvocationID.x;
    if (i >= uint(slots[emitter.SlotRow].Alive))
        return;

    uint     index    = aliveIn[emitter.SlotFirst + i];
    Particle particle = particles[index];
    float    dt       = emitter.DeltaTime;

    float age      = particle.PositionAge.w + dt;
    float lifetime = particle.VelocityLifetime.w;
    if (age >= lifetime)
    {
        int dead = atomicAdd(slots[emitter.SlotRow].Dead, 1);
        deadList[emitter.SlotFirst + uint(dead)] = index;
        return;
    }

    vec3  velocity = particle.VelocityLifetime.xyz + emitter.Gravity * dt;
    velocity      *= max(0.0, 1.0 - emitter.Drag * dt);
    float speed    = SampleCurve(emitter.SpeedOverLife, age / lifetime);
    vec3  before   = particle.PositionAge.xyz;
    vec3  position = before + velocity * speed * dt;

    if (emitter.Collision == COLLISION_HEIGHT_PLANE && position.z < emitter.PlaneHeight && velocity.z < 0.0)
    {
        position.z = emitter.PlaneHeight;
        velocity   = reflect(velocity, vec3(0.0, 0.0, 1.0)) * emitter.Bounce;
        age       += emitter.LifetimeLoss * lifetime;
    }
    else if (emitter.Collision == COLLISION_DEPTH_BUFFER && emitter.DepthValid != 0u)
    {
        mat3  toWorld   = mat3(emitter.DrawMatrix);
        vec3  after     = (emitter.DrawMatrix * vec4(position, 1.0)).xyz;
        float size      = particle.SizeRotation.x * SampleCurve(emitter.SizeOverLife, age / lifetime);
        float thickness = size + distance(before, position) + 0.05;
        vec3  worldVelocity = toWorld * velocity;
        vec3  normal;
        // Only a particle moving into the surface bounces, so one leaving it never sticks.
        if (HitDepth(emitter, (emitter.DrawMatrix * vec4(before, 1.0)).xyz, after, thickness, normal)
            && dot(worldVelocity, normal) < 0.0)
        {
            velocity = inverse(toWorld) * (reflect(worldVelocity, normal) * emitter.Bounce);
            position = before;
            age     += emitter.LifetimeLoss * lifetime;
        }
    }

    particle.PositionAge      = vec4(position, age);
    particle.VelocityLifetime = vec4(velocity, lifetime);
    particles[index]          = particle;

    int alive = atomicAdd(slots[emitter.SlotRow].NewAlive, 1);
    aliveOut[emitter.SlotFirst + uint(alive)] = index;
}
