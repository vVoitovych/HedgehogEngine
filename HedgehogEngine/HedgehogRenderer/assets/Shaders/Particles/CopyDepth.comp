#version 450

// The shadow view's depth, one thread per texel of the collision depth: the depth texel under the
// texel's centre, so the next frame's simulation can collide with what this view saw.

#include "Particles/Common.glsl"

layout(set = 1, binding = 0) uniform sampler2D viewDepth;

layout(local_size_x = 8, local_size_y = 8) in;

void main()
{
    uvec2 texel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(texel, uvec2(COLLISION_DEPTH_SIZE))))
        return;
    vec2  uv     = (vec2(texel) + 0.5) / float(COLLISION_DEPTH_SIZE);
    ivec2 size   = textureSize(viewDepth, 0);
    ivec2 source = min(ivec2(uv * vec2(size)), size - 1);
    collisionDepth[texel.y * COLLISION_DEPTH_SIZE + texel.x] = texelFetch(viewDepth, source, 0).r;
}
