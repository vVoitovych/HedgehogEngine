# HX::DebugLineVertex: a world-space position and an RGBA8 colour, interleaved.
bindings:
  - binding: 0
    stride: 16
    input_rate: per_vertex

attributes:
  - location: 0
    binding: 0
    format: r32g32b32_float
    offset: 0
  - location: 1
    binding: 0
    format: r8g8b8a8_unorm
    offset: 12
